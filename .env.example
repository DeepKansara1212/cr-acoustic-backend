NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MONGODB_URI=mongodb://localhost:27017/cr-acoustic
MONGODB_URI=mongodb-string

JWT_SECRET=jwt-secret-token
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=jwt-refresh-secret-token
